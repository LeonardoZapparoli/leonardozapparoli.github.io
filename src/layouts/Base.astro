---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site } from '../../site.config.mjs';

interface Props {
  title?: string;
  description?: string;
  width?: 'narrow' | 'wide';
}

const {
  title = site.author,
  description = `Personal website and technical notes of ${site.author}.`,
  width = 'narrow',
} = Astro.props;

const noteEntries = (await getCollection('notes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-row">
        <a class="site-name" href="/">{site.author}</a>
        <nav>
          <a href="/">Home</a>
          <div class="nav-item nav-blog"><a href="/blog/">{site.nav.blog}</a></div>
          <div class="nav-item nav-notes"><a href="/notes/">{site.nav.notes}</a></div>
          <a href="/misc/">{site.nav.misc}</a>
          <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
        </nav>
      </div>
      {
        blogPosts.length > 0 && (
          <div class="header-panel panel-blog">
            <div class="panel-inner">
              {blogPosts.map((post) => (
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              ))}
            </div>
          </div>
        )
      }
      {
        noteEntries.length > 0 && (
          <div class="header-panel panel-notes">
            <div class="panel-inner">
              {noteEntries.map((entry) => (
                <a href={`/notes/${entry.id}/`}>{entry.data.title}</a>
              ))}
            </div>
          </div>
        )
      }
    </header>
    <main class={width === 'wide' ? 'main-wide' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">© {year} {site.author}</footer>
    <script is:inline>
      document
        .querySelectorAll('a.email-link[data-user][data-domain]')
        .forEach(function (el) {
          var revealed = false;
          function reveal() {
            if (revealed) return;
            var address = el.dataset.user + '@' + el.dataset.domain;
            el.textContent = address;
            el.href = 'mailto:' + address;
            revealed = true;
          }
          el.addEventListener('mouseenter', reveal);
          el.addEventListener('focus', reveal);
          el.addEventListener('click', function (e) {
            if (!revealed) {
              e.preventDefault();
              reveal();
            }
          });
        });
    </script>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
