---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { lastUpdated, formatDate } from '../../lib/dates.mjs';

const intro = await getEntry('pages', 'repository-intro');
const { Content } = await render(intro);

const entries = (await getCollection('repository')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Base
  title="Technical Repository — Leonardo Zapparoli"
  description="Notes on mathematics and statistics: linear algebra, probability, information theory, optimization, and more."
>
  <h1>Technical Repository</h1>
  <Content />
  <ul class="entry-list">
    {
      entries.map((entry) => (
        <li>
          <a class="entry-title" href={`/repository/${entry.id}/`}>
            {entry.data.title}
          </a>
          <p class="entry-line">
            <span class="code-chip">{entry.data.code}</span> · Last updated{' '}
            {formatDate(lastUpdated(entry.filePath, entry.data.date))}
          </p>
          <p class="entry-desc">{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
